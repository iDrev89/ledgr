datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "prisma-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  allowedAccess Boolean   @default(false)

  sales              Sale[]            @relation("SaleCreator")
  soldSales          Sale[]            @relation("SaleSeller")
  expenses           Expense[]
  purchases          Purchase[]
  performedSaleItems SaleItem[]        @relation("ServicePerformer")
  payrollEntries     PayrollEntry[]
  payrollRunItems    PayrollRunItem[]
  bankTransactions   BankTransaction[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  DIGITAL
  OTHER
}

enum BankTransactionType {
  INCOME
  EXPENSE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum StockMoveType {
  PURCHASE
  SALE
  ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  RECEIVED
  CLOSED
  CANCELED
}

enum AccountsReceivableStatus {
  OPEN
  PARTIAL
  PAID
  CANCELED
}

enum PayrollPeriodType {
  DAILY
  BIWEEKLY
  CUSTOM
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayrollEntryKind {
  COMMISSION
  ADVANCE
  ADJUSTMENT
  PAYMENT
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  docId     String?
  birthdate DateTime? @db.Date
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sales       Sale[]
  receivables AccountsReceivable[]

  @@index([name])
  @@map("customer")
}

model Bank {
  id        String   @id @default(cuid())
  name      String
  accountNo String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salePayments       SalePayment[]
  receivablePayments AccountsReceivablePayment[]
  purchases          Purchase[]
  expenses           Expense[]
  transactions       BankTransaction[]           @relation("BankMovements")
  transfersReceived  BankTransaction[]           @relation("TransferDestination")

  @@unique([name])
  @@index([active])
  @@map("bank")
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([name])
  @@map("product_category")
}

model Product {
  id                String          @id @default(cuid())
  type              ProductType     @default(PRODUCT)
  sku               String?         @unique
  name              String
  description       String?
  price             Decimal         @db.Decimal(12, 2)
  cost              Decimal?        @db.Decimal(12, 2)
  commissionPercent Decimal?        @db.Decimal(5, 2)
  categoryId        String
  category          ProductCategory @relation(fields: [categoryId], references: [id])
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  saleItems     SaleItem[]
  stockMoves    StockMovement[]
  purchaseItems PurchaseItem[]

  @@index([active])
  @@index([categoryId])
  @@map("product")
}

enum SaleStatus {
  DRAFT
  COMPLETED
}

model Sale {
  id            String     @id @default(cuid())
  saleNumber    Int        @unique @default(autoincrement())
  createdById   String
  createdBy     User       @relation("SaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  soldById      String?
  soldBy        User?      @relation("SaleSeller", fields: [soldById], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id])
  currency      String     @default("COP")
  subtotal      Decimal    @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  status        SaleStatus @default(COMPLETED)
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items      SaleItem[]
  payments   SalePayment[]
  receivable AccountsReceivable?

  @@index([createdById, createdAt])
  @@index([soldById])
  @@index([customerId, createdAt])
  @@index([saleNumber])
  @@index([status])
  @@map("sale")
}

model SaleItem {
  id                       String   @id @default(cuid())
  saleId                   String
  productId                String
  quantity                 Int
  unitPrice                Decimal  @db.Decimal(12, 2)
  discount                 Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal                Decimal  @db.Decimal(12, 2)
  performedById            String?
  commissionPercentApplied Decimal? @db.Decimal(5, 2)

  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  performedBy User?   @relation("ServicePerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([performedById])
  @@map("sale_item")
}

model SalePayment {
  id            String        @id @default(cuid())
  saleId        String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  reference     String?
  bankId        String?
  bank          Bank?         @relation(fields: [bankId], references: [id])
  attachmentUrl String? // URL del comprobante en S3

  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation("FromSalePayment")

  @@index([saleId, paidAt])
  @@index([bankId])
  @@map("sale_payment")
}

model ExpenseCategory {
  id        String            @id @default(cuid())
  name      String
  parentId  String?
  parent    ExpenseCategory?  @relation("ExpenseCategoryHierarchy", fields: [parentId], references: [id])
  children  ExpenseCategory[] @relation("ExpenseCategoryHierarchy")
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  expenses     Expense[]
  expenseItems ExpenseItem[]

  @@unique([name])
  @@map("expense_category")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  expenses  Expense[]

  @@index([name])
  @@map("supplier")
}

model Expense {
  id            String           @id @default(cuid())
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id])
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  supplierId    String?
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  description   String?
  invoiceNo     String?
  attachment    String?
  currency      String           @default("COP")
  amount        Decimal          @db.Decimal(12, 2)
  paymentMethod PaymentMethod    @default(CASH)
  bankId        String?
  bank          Bank?            @relation(fields: [bankId], references: [id])
  reference     String?
  incurredAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items           ExpenseItem[]
  bankTransaction BankTransaction? @relation("FromExpense")

  @@index([createdById, incurredAt])
  @@index([supplierId, invoiceNo])
  @@index([bankId])
  @@map("expense")
}

model ExpenseItem {
  id          String  @id @default(cuid())
  expenseId   String
  categoryId  String?
  description String?
  quantity    Decimal @default(1) @db.Decimal(12, 4)
  unitAmount  Decimal @default(0) @db.Decimal(12, 4)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  expense  Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id])

  @@index([expenseId])
  @@map("expense_item")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber Int            @unique @default(autoincrement())
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  currency       String         @default("COP")
  invoiceNo      String?
  status         PurchaseStatus @default(DRAFT)
  note           String?

  // Campos de pago
  paymentMethod PaymentMethod @default(CASH)
  bankId        String?
  bank          Bank?         @relation(fields: [bankId], references: [id])
  reference     String?

  subtotal    Decimal  @db.Decimal(12, 2)
  taxTotal    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items           PurchaseItem[]
  bankTransaction BankTransaction? @relation("FromPurchase")

  @@index([supplierId, invoiceNo])
  @@index([status, createdAt])
  @@index([bankId])
  @@map("purchase")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Decimal @db.Decimal(12, 4)
  lineTotal  Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_item")
}

model StockMovement {
  id        String        @id @default(cuid())
  productId String
  moveType  StockMoveType
  quantity  Int
  unitCost  Decimal?      @db.Decimal(12, 4)
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, moveType, createdAt])
  @@map("stock_movement")
}

model AccountsReceivable {
  id         String                   @id @default(cuid())
  customerId String
  customer   Customer                 @relation(fields: [customerId], references: [id])
  saleId     String?                  @unique
  sale       Sale?                    @relation(fields: [saleId], references: [id])
  currency   String                   @default("COP")
  total      Decimal                  @db.Decimal(12, 2)
  balance    Decimal                  @db.Decimal(12, 2)
  status     AccountsReceivableStatus @default(OPEN)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  payments AccountsReceivablePayment[]

  @@index([customerId, status, createdAt])
  @@map("receivable")
}

model AccountsReceivablePayment {
  id           String        @id @default(cuid())
  receivableId String
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime      @default(now())
  method       PaymentMethod
  note         String?
  bankId       String?
  bank         Bank?         @relation(fields: [bankId], references: [id])

  receivable      AccountsReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction?   @relation("FromReceivablePayment")

  @@index([receivableId, paidAt])
  @@index([bankId])
  @@map("receivable_payment")
}

model PayrollEntry {
  id          String           @id @default(cuid())
  userId      String
  kind        PayrollEntryKind
  description String?
  currency    String           @default("COP")
  amount      Decimal          @db.Decimal(12, 2)
  period      String
  runId       String?
  createdAt   DateTime         @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  run  PayrollRun? @relation(fields: [runId], references: [id])

  @@index([userId, period, kind])
  @@index([runId])
  @@map("payroll_entry")
}

model PayrollRun {
  id          String            @id @default(cuid())
  periodType  PayrollPeriodType
  periodLabel String
  startDate   DateTime
  endDate     DateTime
  status      PayrollRunStatus  @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items   PayrollRunItem[]
  entries PayrollEntry[]

  @@index([status, startDate])
  @@map("payroll_run")
}

model PayrollRunItem {
  id               String   @id @default(cuid())
  runId            String
  userId           String
  commissionsTotal Decimal  @default(0) @db.Decimal(12, 2)
  advancesTotal    Decimal  @default(0) @db.Decimal(12, 2)
  adjustmentsTotal Decimal  @default(0) @db.Decimal(12, 2)
  salaryFixed      Decimal? @db.Decimal(12, 2)
  payableTotal     Decimal  @db.Decimal(12, 2)
  paidAmount       Decimal  @default(0) @db.Decimal(12, 2)
  balance          Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  run  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([runId, userId])
  @@index([runId])
  @@index([userId])
  @@map("payroll_run_item")
}

model BankTransaction {
  id              String              @id @default(cuid())
  bankId          String
  bank            Bank                @relation("BankMovements", fields: [bankId], references: [id])
  type            BankTransactionType
  amount          Decimal             @db.Decimal(12, 2)
  description     String?
  reference       String?
  transactionDate DateTime            @default(now())
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  salePaymentId       String?                    @unique
  salePayment         SalePayment?               @relation("FromSalePayment", fields: [salePaymentId], references: [id])
  receivablePaymentId String?                    @unique
  receivablePayment   AccountsReceivablePayment? @relation("FromReceivablePayment", fields: [receivablePaymentId], references: [id])
  expenseId           String?                    @unique
  expense             Expense?                   @relation("FromExpense", fields: [expenseId], references: [id])
  purchaseId          String?                    @unique
  purchase            Purchase?                  @relation("FromPurchase", fields: [purchaseId], references: [id])
  relatedBankId       String?
  relatedBank         Bank?                      @relation("TransferDestination", fields: [relatedBankId], references: [id])
  transferPairId      String?                    @unique

  @@index([bankId, transactionDate])
  @@index([type])
  @@map("bank_transaction")
}
