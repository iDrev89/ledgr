datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "prisma-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// ==================== AUTH MODELS (better-auth) ====================

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  allowedAccess Boolean   @default(false)

  sales              Sale[]               @relation("SaleCreator")
  soldSales          Sale[]               @relation("SaleSeller")
  expenses           Expense[]
  purchases          Purchase[]
  performedSaleItems SaleItem[]           @relation("ServicePerformer")
  payrollEntries     PayrollEntry[]
  payrollRunItems    PayrollRunItem[]
  accountTransactions  AccountTransaction[]
  branches             UserBranch[]
  cashRegisterCloses   CashRegisterClose[]
  reconciledAccounts   AccountReconciliation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ==================== ENUMS ====================

enum ProductType {
  PRODUCT
  SERVICE
}

enum AccountType {
  BANK
  CASH_REGISTER
  PETTY_CASH
  DIGITAL_WALLET
  CREDIT_LINE
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  DIGITAL_PAYMENT
  CHECK
  OTHER
}

enum AccountTransactionType {
  INCOME
  EXPENSE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum StockMoveType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  RECEIVED
  CLOSED
  CANCELED
}

enum AccountsReceivableStatus {
  OPEN
  PARTIAL
  PAID
  CANCELED
}

enum PayrollPeriodType {
  DAILY
  BIWEEKLY
  CUSTOM
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayrollEntryKind {
  COMMISSION
  ADVANCE
  ADJUSTMENT
  PAYMENT
}

enum SaleStatus {
  DRAFT
  COMPLETED
}

// ==================== ORGANIZATIONAL MODELS ====================

model BusinessLine {
  id        String   @id @default(cuid())
  name      String
  code      String?
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  sales    Sale[]
  expenses Expense[]

  @@unique([name])
  @@map("business_line")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String?
  address   String?
  phone     String?
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialAccounts FinancialAccount[]
  sales             Sale[]
  expenses          Expense[]
  purchases         Purchase[]
  users             UserBranch[]
  cashCloses        CashRegisterClose[]
  stockMoves        StockMovement[]

  @@unique([name])
  @@map("branch")
}

model UserBranch {
  id       String  @id @default(cuid())
  userId   String
  branchId String
  role     String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branch")
}

// ==================== FINANCIAL MODELS ====================

model FinancialAccount {
  id             String      @id @default(cuid())
  type           AccountType @default(BANK)
  name           String
  accountNumber  String?
  institution    String?
  initialBalance Decimal     @default(0) @db.Decimal(12, 2)
  active         Boolean     @default(true)
  isDefault      Boolean     @default(false)
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  salePayments       SalePayment[]
  receivablePayments AccountsReceivablePayment[]
  purchases          Purchase[]
  expenses           Expense[]
  transactions       AccountTransaction[]  @relation("AccountMovements")
  transfersReceived  AccountTransaction[]  @relation("TransferDestination")
  cashCloses         CashRegisterClose[]
  reconciliations    AccountReconciliation[]

  @@unique([name])
  @@index([active])
  @@index([type])
  @@index([branchId])
  @@map("financial_account")
}

model AccountTransaction {
  id              String                 @id @default(cuid())
  accountId       String
  account         FinancialAccount       @relation("AccountMovements", fields: [accountId], references: [id])
  type            AccountTransactionType
  amount          Decimal                @db.Decimal(12, 2)
  description     String?
  reference       String?
  transactionDate DateTime               @default(now())
  createdById     String?
  createdBy       User?                  @relation(fields: [createdById], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  salePaymentId       String?                    @unique
  salePayment         SalePayment?               @relation("FromSalePayment", fields: [salePaymentId], references: [id])
  receivablePaymentId String?                    @unique
  receivablePayment   AccountsReceivablePayment? @relation("FromReceivablePayment", fields: [receivablePaymentId], references: [id])
  expenseId           String?                    @unique
  expense             Expense?                   @relation("FromExpense", fields: [expenseId], references: [id])
  purchaseId          String?                    @unique
  purchase            Purchase?                  @relation("FromPurchase", fields: [purchaseId], references: [id])
  relatedAccountId    String?
  relatedAccount      FinancialAccount?          @relation("TransferDestination", fields: [relatedAccountId], references: [id])
  transferPairId      String?                    @unique
  reconciliationItems ReconciliationItem[]

  @@index([accountId, transactionDate])
  @@index([type])
  @@map("account_transaction")
}

// ==================== CORE BUSINESS MODELS ====================

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  docId     String?
  birthdate DateTime? @db.Date
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sales       Sale[]
  receivables AccountsReceivable[]

  @@index([name])
  @@map("customer")
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([name])
  @@map("product_category")
}

model Product {
  id                String          @id @default(cuid())
  type              ProductType     @default(PRODUCT)
  sku               String?         @unique
  name              String
  description       String?
  price             Decimal         @db.Decimal(12, 2)
  cost              Decimal?        @db.Decimal(12, 2)
  commissionPercent Decimal?        @db.Decimal(5, 2)
  categoryId        String
  category          ProductCategory @relation(fields: [categoryId], references: [id])
  businessLineId    String?
  businessLine      BusinessLine?   @relation(fields: [businessLineId], references: [id])
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  saleItems     SaleItem[]
  stockMoves    StockMovement[]
  purchaseItems PurchaseItem[]

  @@index([active])
  @@index([categoryId])
  @@index([businessLineId])
  @@map("product")
}

model Sale {
  id             String        @id @default(cuid())
  saleNumber     Int           @unique @default(autoincrement())
  createdById    String
  createdBy      User          @relation("SaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  soldById       String?
  soldBy         User?         @relation("SaleSeller", fields: [soldById], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  businessLineId String?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id])
  currency       String        @default("COP")
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @db.Decimal(12, 2) @default(0)
  taxTotal       Decimal       @db.Decimal(12, 2) @default(0)
  total          Decimal       @db.Decimal(12, 2)
  status         SaleStatus    @default(COMPLETED)
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items      SaleItem[]
  payments   SalePayment[]
  receivable AccountsReceivable?

  @@index([createdById, createdAt])
  @@index([soldById])
  @@index([customerId, createdAt])
  @@index([saleNumber])
  @@index([status])
  @@index([branchId])
  @@index([businessLineId])
  @@map("sale")
}

model SaleItem {
  id                       String   @id @default(cuid())
  saleId                   String
  productId                String
  quantity                 Int
  unitPrice                Decimal  @db.Decimal(12, 2)
  discount                 Decimal  @db.Decimal(12, 2) @default(0)
  lineTotal                Decimal  @db.Decimal(12, 2)
  performedById            String?
  commissionPercentApplied Decimal? @db.Decimal(5, 2)

  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  performedBy User?   @relation("ServicePerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([performedById])
  @@map("sale_item")
}

model SalePayment {
  id            String           @id @default(cuid())
  saleId        String
  amount        Decimal          @db.Decimal(12, 2)
  method        PaymentMethod
  paidAt        DateTime         @default(now())
  reference     String?
  accountId     String
  account       FinancialAccount @relation(fields: [accountId], references: [id])
  attachmentUrl String?

  sale               Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  accountTransaction AccountTransaction? @relation("FromSalePayment")

  @@index([saleId, paidAt])
  @@index([accountId])
  @@map("sale_payment")
}

// ==================== EXPENSE MODELS ====================

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    ExpenseCategory?  @relation("ExpenseCategoryHierarchy", fields: [parentId], references: [id])
  children  ExpenseCategory[] @relation("ExpenseCategoryHierarchy")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses     Expense[]
  expenseItems ExpenseItem[]

  @@unique([name])
  @@map("expense_category")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  expenses  Expense[]

  @@index([name])
  @@map("supplier")
}

model Expense {
  id             String           @id @default(cuid())
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id])
  categoryId     String?
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id])
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id])
  businessLineId String?
  businessLine   BusinessLine?    @relation(fields: [businessLineId], references: [id])
  description    String?
  invoiceNo      String?
  attachment     String?
  currency       String           @default("COP")
  amount         Decimal          @db.Decimal(12, 2)
  paymentMethod  PaymentMethod    @default(CASH)
  accountId      String?
  account        FinancialAccount? @relation(fields: [accountId], references: [id])
  reference      String?
  incurredAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items              ExpenseItem[]
  accountTransaction AccountTransaction? @relation("FromExpense")

  @@index([createdById, incurredAt])
  @@index([supplierId, invoiceNo])
  @@index([accountId])
  @@index([branchId])
  @@index([businessLineId])
  @@map("expense")
}

model ExpenseItem {
  id          String           @id @default(cuid())
  expenseId   String
  categoryId  String?
  description String?
  quantity    Decimal          @db.Decimal(12, 4) @default(1)
  unitAmount  Decimal          @db.Decimal(12, 4) @default(0)
  taxPercent  Decimal          @db.Decimal(5, 2) @default(0)
  lineTotal   Decimal          @db.Decimal(12, 2)

  expense  Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id])

  @@index([expenseId])
  @@map("expense_item")
}

// ==================== PURCHASE MODELS ====================

model Purchase {
  id             String           @id @default(cuid())
  purchaseNumber Int              @unique @default(autoincrement())
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id])
  currency       String           @default("COP")
  invoiceNo      String?
  status         PurchaseStatus   @default(DRAFT)
  note           String?
  paymentMethod  PaymentMethod    @default(CASH)
  accountId      String?
  account        FinancialAccount? @relation(fields: [accountId], references: [id])
  reference      String?
  subtotal       Decimal          @db.Decimal(12, 2)
  taxTotal       Decimal          @db.Decimal(12, 2) @default(0)
  total          Decimal          @db.Decimal(12, 2)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items              PurchaseItem[]
  accountTransaction AccountTransaction? @relation("FromPurchase")

  @@index([supplierId, invoiceNo])
  @@index([status, createdAt])
  @@index([accountId])
  @@index([branchId])
  @@map("purchase")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 4)
  lineTotal  Decimal  @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_item")
}

// ==================== INVENTORY ====================

model StockMovement {
  id        String        @id @default(cuid())
  productId String
  branchId  String?
  branch    Branch?       @relation(fields: [branchId], references: [id])
  moveType  StockMoveType
  quantity  Int
  unitCost  Decimal?      @db.Decimal(12, 4)
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, branchId, moveType, createdAt])
  @@map("stock_movement")
}

// ==================== ACCOUNTS RECEIVABLE ====================

model AccountsReceivable {
  id         String                   @id @default(cuid())
  customerId String
  customer   Customer                 @relation(fields: [customerId], references: [id])
  saleId     String?                  @unique
  sale       Sale?                    @relation(fields: [saleId], references: [id])
  currency   String                   @default("COP")
  total      Decimal                  @db.Decimal(12, 2)
  balance    Decimal                  @db.Decimal(12, 2)
  status     AccountsReceivableStatus @default(OPEN)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  payments AccountsReceivablePayment[]

  @@index([customerId, status, createdAt])
  @@map("receivable")
}

model AccountsReceivablePayment {
  id           String           @id @default(cuid())
  receivableId String
  amount       Decimal          @db.Decimal(12, 2)
  paidAt       DateTime         @default(now())
  method       PaymentMethod
  note         String?
  accountId    String?
  account      FinancialAccount? @relation(fields: [accountId], references: [id])

  receivable         AccountsReceivable  @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  accountTransaction AccountTransaction? @relation("FromReceivablePayment")

  @@index([receivableId, paidAt])
  @@index([accountId])
  @@map("receivable_payment")
}

// ==================== PAYROLL ====================

model PayrollEntry {
  id          String            @id @default(cuid())
  userId      String
  kind        PayrollEntryKind
  description String?
  currency    String            @default("COP")
  amount      Decimal           @db.Decimal(12, 2)
  period      String
  runId       String?
  createdAt   DateTime          @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  run  PayrollRun? @relation(fields: [runId], references: [id])

  @@index([userId, period, kind])
  @@index([runId])
  @@map("payroll_entry")
}

model PayrollRun {
  id          String             @id @default(cuid())
  periodType  PayrollPeriodType
  periodLabel String
  startDate   DateTime
  endDate     DateTime
  status      PayrollRunStatus   @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  items   PayrollRunItem[]
  entries PayrollEntry[]

  @@index([status, startDate])
  @@map("payroll_run")
}

model PayrollRunItem {
  id               String   @id @default(cuid())
  runId            String
  userId           String
  commissionsTotal Decimal  @db.Decimal(12, 2) @default(0)
  advancesTotal    Decimal  @db.Decimal(12, 2) @default(0)
  adjustmentsTotal Decimal  @db.Decimal(12, 2) @default(0)
  salaryFixed      Decimal? @db.Decimal(12, 2)
  payableTotal     Decimal  @db.Decimal(12, 2)
  paidAmount       Decimal  @db.Decimal(12, 2) @default(0)
  balance          Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  run  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([runId, userId])
  @@index([runId])
  @@index([userId])
  @@map("payroll_run_item")
}

// ==================== RECONCILIATION & CASH CLOSE ====================

enum ReconciliationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model CashRegisterClose {
  id              String           @id @default(cuid())
  accountId       String
  account         FinancialAccount @relation(fields: [accountId], references: [id])
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])
  closeDate       DateTime         @default(now())
  expectedBalance Decimal          @db.Decimal(12, 2)
  actualBalance   Decimal          @db.Decimal(12, 2)
  difference      Decimal          @db.Decimal(12, 2)
  notes           String?
  closedById      String
  closedBy        User             @relation(fields: [closedById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([accountId, closeDate])
  @@index([branchId])
  @@map("cash_register_close")
}

model AccountReconciliation {
  id               String               @id @default(cuid())
  accountId        String
  account          FinancialAccount     @relation(fields: [accountId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  openingBalance   Decimal              @db.Decimal(12, 2)
  closingBalance   Decimal              @db.Decimal(12, 2)
  statementBalance Decimal              @db.Decimal(12, 2)
  difference       Decimal              @db.Decimal(12, 2)
  status           ReconciliationStatus @default(DRAFT)
  reconciledAt     DateTime?
  reconciledById   String?
  reconciledBy     User?                @relation(fields: [reconciledById], references: [id])
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  items ReconciliationItem[]

  @@index([accountId, periodStart])
  @@index([status])
  @@map("account_reconciliation")
}

model ReconciliationItem {
  id               String   @id @default(cuid())
  reconciliationId String
  transactionId    String?
  externalRef      String?
  externalAmount   Decimal? @db.Decimal(12, 2)
  externalDate     DateTime?
  status           String   @default("UNMATCHED")
  createdAt        DateTime @default(now())

  reconciliation AccountReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transaction    AccountTransaction?   @relation(fields: [transactionId], references: [id])

  @@index([reconciliationId])
  @@index([transactionId])
  @@map("reconciliation_item")
}
